APP_ENV=development
APP_DEBUG=true

API_V1_PREFIX=/api/v1
PROJECT_NAME=peso-tugma-ai

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Embeddings — hosted inference endpoint (replaces the local sentence-transformers
# model). Default serves the paper's model (all-MiniLM-L6-v2) via the Hugging Face
# Inference API. EMBEDDING_API_TOKEN is required in practice (HF rejects anonymous
# requests); create one at https://huggingface.co/settings/tokens.
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
EMBEDDING_API_TOKEN=
EMBEDDING_API_TIMEOUT=30

# Uploaded resumes are stored in Vercel Blob. Creating a Blob store on Vercel
# provisions this token automatically; for local dev pull it via `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# MongoDB
# Provide credentials/host as components; the app URL-encodes them and assembles
# MONGODB_URI (see app/core/config.py). For MongoDB Atlas use MONGODB_SCHEME=mongodb+srv
# and a hostname without a port (e.g. cluster0.xxxxx.mongodb.net).
# To pass a full connection string instead, set MONGODB_URI directly (already escaped).
MONGODB_USERNAME=username
MONGODB_PASSWORD=password
MONGODB_SCHEME=mongodb
MONGODB_HOST=localhost:27017
MONGODB_OPTIONS=
MONGODB_DB_NAME=peso_tugma_ai

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies (httpOnly). Keep COOKIE_SECURE=false for local http; set true in
# production (HTTPS). Use COOKIE_SAMESITE=none (with secure=true) only for a
# cross-site frontend domain.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
